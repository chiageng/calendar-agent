# Copy to .env (never commit .env). Values are read by python-dotenv at startup.

# Which calendar to manage: google (default) or microsoft.
CALENDAR_PROVIDER=google

# ---- Google Calendar (default) -------------------------------------------------------------
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID, type "Desktop app".
# Google requires the client secret of a Desktop client for the token exchange; it is not
# treated as confidential by Google for installed apps, but keep it out of git all the same.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Scopes (short names). Read-only: calendar.events.readonly   Writes: calendar.events
GOOGLE_SCOPES=calendar.events

# ---- Microsoft 365 / Outlook.com (optional, CALENDAR_PROVIDER=microsoft) -------------------
# Application (client) ID of your Entra app registration. Public client: NO client secret.
# MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MS_TENANT_ID=common
# MS_SCOPES=User.Read Calendars.ReadWrite

# ---- Optional overrides -----------------------------------------------------------------------
# CALENDAR_AGENT_TIMEZONE=Asia/Singapore
# CALENDAR_AGENT_STATE_DIR=~/.local/state/outlook-calendar-agent
